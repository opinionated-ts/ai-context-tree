{
  "name": "@opinionated-ts/brain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/brain.git"
  },
  "type": "module",
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "ai:sync": "bun run ./scripts/update-local/index.ts",
    "context:index": "bun run ./scripts/context-index/index.ts",
    "context:index:export": "bun run ./scripts/context-index/index.ts --export markdown",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.8.8",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
