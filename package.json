{
  "name": "ai-context-tree",
  "bugs": {
    "url": "https://github.com/opinionated-ts/ai-context-tree/issues",
    "email": "danhezcode@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/ai-context-tree.git"
  },
  "type": "module",
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "ai:sync": "bun run ./scripts/update-local/index.ts",
    "context-tree": "bun run ./src/core/index.ts",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.8.8",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
